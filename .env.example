# Advers Application Environment Variables

# MySQL Database Connection String
# Example format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/advers_db"

# NextAuth / Session Secret
NEXTAUTH_SECRET="advers-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NODE_ENV="development"
