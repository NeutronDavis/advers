# Advers Application Environment Variables

# MySQL Database Connection String
# Example format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/advers_db"

# NextAuth / Session Secret
NEXTAUTH_SECRET="advers-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NODE_ENV="development"

# Payments & USDC wallet (Phase 2)
# mock | yellowcard. Yellow Card requires the Phase 0 sandbox contract first.
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="advers-dev-webhook-secret"
YELLOWCARD_API_KEY=""

# 32 bytes, base64 or 64 hex characters. Required in production.
TOTP_ENCRYPTION_KEY=""

# Sandbox FX and limits. Replace with the provider quote in production.
MOCK_NGN_PER_USDC="1600"
MIN_FUNDING_NGN="1000"
MAX_FUNDING_NGN="10000000"
WITHDRAWAL_FEE_USDC="0"

# Media uploads (Phase 5 local storage driver)
MAX_MEDIA_BYTES="209715200"
