// Prisma Schema for Advers Web Platform & Client Onboarding App
// Database: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  STAFF
  ADMIN
}

enum OrgRole {
  OWNER
  MEMBER
}

enum UserStatus {
  UNVERIFIED
  PROSPECT
  ACTIVE
  DEACTIVATED
}

enum FeedbackType {
  ENQUIRY
  FEEDBACK
  COMPLAINT
  BILLBOARD_ENQUIRY
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  REPLIED
  RESOLVED
  ARCHIVED
  SPAM
}

enum EngagementType {
  DIGITAL_PACKAGE
  ECOSYSTEM
  BILLBOARD
  CARE_PLAN
}

enum EngagementStatus {
  PROSPECT
  QUALIFIED
  QUOTE_SENT
  ACCEPTED
  ONBOARDING_IN_PROGRESS
  IN_PRODUCTION
  REVIEW
  LAUNCHED
  ACTIVE
  PAUSED
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum RenewalStatus {
  UPCOMING
  RENEWED
  CANCELLED
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  passwordHash       String?
  name               String
  phone              String?
  role               Role          @default(CLIENT)
  orgRole            OrgRole       @default(MEMBER)
  status             UserStatus    @default(UNVERIFIED)
  source             String?       @default("ORGANIC")
  utmSource          String?
  utmCampaign        String?
  emailVerifiedAt    DateTime?
  profileCompleteAt  DateTime?
  termsAcceptedAt    DateTime?
  termsVersion       String?       @default("1.0")
  lastLoginAt        DateTime?
  clientId           String?
  client             Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoices           Invoice[]
  campaigns          Campaign[]
  wallet             Wallet?
  activityLogs       ActivityLog[]
  auditLogs          AuditLog[]    @relation("AuditActor")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([email])
  @@index([clientId])
  @@index([createdAt])
  @@index([status])
}

model Client {
  id           String        @id @default(cuid())
  name         String
  industry     String?
  address      String?       @db.Text
  notes        String?       @db.Text
  users        User[]
  engagements  Engagement[]
  campaigns    Campaign[]
  invitations  Invitation[]
  invoices     Invoice[]
  quotes       Quote[]
  renewals     Renewal[]
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Invitation {
  id           String    @id @default(cuid())
  email        String
  tokenHash    String    @unique
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orgRole      OrgRole   @default(MEMBER)
  invitedById  String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([tokenHash])
  @@index([email])
}

model Lead {
  id                 String    @id @default(cuid())
  name               String
  email              String
  phone              String?
  company            String?
  source             String?   @default("WEBSITE")
  utmSource          String?
  utmCampaign        String?
  packageInterest    String?
  budgetRange        String?
  timeline           String?
  status             String    @default("NEW")
  convertedClientId  String?
  quotes             Quote[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([createdAt])
  @@index([status])
}

model Feedback {
  id             String         @id @default(cuid())
  type           FeedbackType   @default(ENQUIRY)
  status         FeedbackStatus @default(NEW)
  name           String
  email          String
  phone          String?
  company        String?
  message        String         @db.Text
  rating         Int?
  packageInterest String?
  source         String?        @default("WEBSITE")
  isTestimonial  Boolean        @default(false)
  isPublished    Boolean        @default(false)
  internalNote   String?        @db.Text
  assignedToId   String?
  leadId         String?
  repliedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Package {
  id                   String       @id @default(cuid())
  key                  String       @unique
  name                 String
  tagline              String?
  priceMin             Int
  priceMax             Int
  inclusionsJson       String       @db.Text
  defaultMilestonesJson String?     @db.Text
  engagements          Engagement[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Engagement {
  id                 String               @id @default(cuid())
  clientId           String
  client             Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type               EngagementType       @default(DIGITAL_PACKAGE)
  packageId          String?
  package            Package?             @relation(fields: [packageId], references: [id], onDelete: SetNull)
  status             EngagementStatus     @default(PROSPECT)
  onboardingProgress Int                  @default(0)
  waitingOnClient    Boolean              @default(false)
  responses          OnboardingResponse[]
  invoices           Invoice[]
  renewals           Renewal[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model OnboardingResponse {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  stepKey      String
  dataJson     String     @db.Text
  completedAt  DateTime   @default(now())

  @@unique([engagementId, stepKey])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagementId  String?
  engagement    Engagement?   @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  title         String
  amount        Int
  serviceType   String        @default("DIGITAL_PACKAGE")
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime
  paidAt        DateTime?
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Int
  paymentMethod String        @default("PAYSTACK")
  reference     String        @unique
  status        PaymentStatus @default(SUCCESS)
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([createdAt])
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  leadId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title       String
  amount      Int
  status      QuoteStatus @default(SENT)
  openedAt    DateTime?
  sentAt      DateTime    @default(now())
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Renewal {
  id           String        @id @default(cuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engagementId String?
  engagement   Engagement?   @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  title        String
  amount       Int
  renewalDate  DateTime
  status       RenewalStatus @default(UPCOMING)
  createdAt    DateTime      @default(now())

  @@index([clientId])
  @@index([status])
  @@index([renewalDate])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  action      String
  description String   @db.Text
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// ==========================================
// ADVERS MULTI-CHANNEL ADVERTISING PLATFORM
// ==========================================

enum ChannelType {
  DIGITAL_BILLBOARD
  STATIC_BILLBOARD
  FM_RADIO
  TELEVISION
  NEWSPAPER
  PODCAST
  ADBOOSTERS
  INFLUENCER
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SCHEDULED
  ACTIVE
  COMPLETED
  REVISION_REQUESTED
  CANCELLED
}

model Campaign {
  id                 String              @id @default(cuid())
  campaignNumber     String              @unique
  name               String
  channel            ChannelType
  status             CampaignStatus      @default(PENDING_REVIEW)
  objective          String
  targetLocation     String
  budget             Int                 // in Naira (₦)
  duration           String              // e.g. "2 weeks"
  startDate          DateTime?
  endDate            DateTime?
  creativeAssetUrl   String?
  creativeAssetType  String?             // e.g. "MP4 Video 1080x1920"
  arconCode          String?             // ARCON approval number
  complianceNotes    String?             @db.Text
  channelConfigJson  String?             @db.Text
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           String?
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  inventoryId        String?
  inventory          MediaInventory?     @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  proofs             ProofOfPerformance[]
  boosterLinks       BoosterLink[]
  settlements        MediaSettlement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
}

model MediaInventory {
  id              String       @id @default(cuid())
  inventoryCode   String       @unique
  name            String
  channel         ChannelType
  city            String
  state           String
  locationDetails String
  screenSpecs     String?
  loopCapacity    String?      // e.g. "12 slots (15s spot)"
  availableSlots  Int          @default(1)
  ratePerUnit     Int          // in Naira (₦)
  unitType        String       // "per_day", "per_spot_30s", "per_issue", "per_episode"
  vendorName      String
  vendorContact   String?
  status          String       @default("OPERATIONAL")
  campaigns       Campaign[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([channel])
  @@index([city])
  @@index([status])
}

model ProofOfPerformance {
  id                 String    @id @default(cuid())
  proofCode          String    @unique
  campaignId         String
  campaign           Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type               String    // "DAY_PHOTO", "NIGHT_PHOTO", "BROADCAST_AFFIDAVIT", "TEARSHEET"
  fileUrl            String
  thumbnailUrl       String?
  caption            String?
  broadcastTimestamp DateTime?
  verifiedBy         String
  verifiedAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())

  @@index([campaignId])
}

model AdBooster {
  id                    String        @id @default(cuid())
  userId                String?
  name                  String
  handle                String
  phone                 String
  networkType           String        // "WhatsApp & Telegram", "Instagram", "X"
  audienceReach         Int           @default(0)
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  totalEarnedCommission Int           @default(0)
  fraudRisk             String        @default("LOW") // "LOW", "MEDIUM", "CRITICAL_BOT"
  status                String        @default("ACTIVE")
  links                 BoosterLink[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status])
}

model BoosterLink {
  id                 String    @id @default(cuid())
  code               String    @unique
  campaignId         String
  campaign           Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  boosterId          String
  booster            AdBooster @relation(fields: [boosterId], references: [id], onDelete: Cascade)
  clicksCount        Int       @default(0)
  sharesCount        Int       @default(0)
  conversionsCount   Int       @default(0)
  commissionAccrued  Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([campaignId])
  @@index([boosterId])
}

model MediaSettlement {
  id               String    @id @default(cuid())
  settlementNumber String    @unique
  campaignId       String
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  vendorName       String
  grossAmount      Int       // Total client budget
  vendorPayout     Int       // Amount paid to TV/Radio/Screen owner
  adversFee        Int       // Advers agency fee
  status           String    @default("READY_FOR_PAYOUT") // "LOCKED_IN_ESCROW", "READY_FOR_PAYOUT", "SETTLED"
  settledAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([campaignId])
  @@index([status])
}

model Wallet {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Int                 @default(0)
  escrowBalance    Int                 @default(0)
  totalSpent       Int                 @default(0)
  transactions     WalletTransaction[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String   // "DEPOSIT", "ESCROW_LOCK", "ESCROW_RELEASE", "REFUND"
  amount      Int      // in Naira (₦)
  reference   String   @unique
  description String
  status      String   @default("SUCCESS")
  createdAt   DateTime @default(now())

  @@index([walletId])
  @@index([createdAt])
}

