// Prisma Schema for Advers Web Platform & Client Onboarding App
// Database: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  STAFF
  ADMIN
}

enum OrgRole {
  OWNER
  MEMBER
}

enum FeedbackType {
  ENQUIRY
  FEEDBACK
  COMPLAINT
  BILLBOARD_ENQUIRY
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  REPLIED
  RESOLVED
  ARCHIVED
  SPAM
}

enum EngagementType {
  DIGITAL_PACKAGE
  ECOSYSTEM
  BILLBOARD
  CARE_PLAN
}

enum EngagementStatus {
  PROSPECT
  QUALIFIED
  QUOTE_SENT
  ACCEPTED
  ONBOARDING_IN_PROGRESS
  IN_PRODUCTION
  REVIEW
  LAUNCHED
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String?
  name               String
  phone              String?
  role               Role       @default(CLIENT)
  orgRole            OrgRole    @default(MEMBER)
  emailVerifiedAt    DateTime?
  profileCompleteAt  DateTime?
  termsAcceptedAt    DateTime?
  termsVersion       String?    @default("1.0")
  lastLoginAt        DateTime?
  clientId           String?
  client             Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([email])
  @@index([clientId])
}

model Client {
  id           String        @id @default(cuid())
  name         String
  industry     String?
  address      String?       @db.Text
  notes        String?       @db.Text
  users        User[]
  engagements  Engagement[]
  invitations  Invitation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Invitation {
  id           String    @id @default(cuid())
  email        String
  tokenHash    String    @unique
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orgRole      OrgRole   @default(MEMBER)
  invitedById  String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([tokenHash])
  @@index([email])
}

model Lead {
  id                 String    @id @default(cuid())
  name               String
  email              String
  phone              String?
  company            String?
  source             String?   @default("WEBSITE")
  packageInterest    String?
  budgetRange        String?
  timeline           String?
  status             String    @default("NEW")
  convertedClientId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Feedback {
  id             String         @id @default(cuid())
  type           FeedbackType   @default(ENQUIRY)
  status         FeedbackStatus @default(NEW)
  name           String
  email          String
  phone          String?
  company        String?
  message        String         @db.Text
  rating         Int?
  packageInterest String?
  source         String?        @default("WEBSITE")
  isTestimonial  Boolean        @default(false)
  isPublished    Boolean        @default(false)
  internalNote   String?        @db.Text
  assignedToId   String?
  leadId         String?
  repliedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Package {
  id                   String       @id @default(cuid())
  key                  String       @unique
  name                 String
  tagline              String?
  priceMin             Int
  priceMax             Int
  inclusionsJson       String       @db.Text
  defaultMilestonesJson String?     @db.Text
  engagements          Engagement[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Engagement {
  id                 String               @id @default(cuid())
  clientId           String
  client             Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type               EngagementType       @default(DIGITAL_PACKAGE)
  packageId          String?
  package            Package?             @relation(fields: [packageId], references: [id], onDelete: SetNull)
  status             EngagementStatus     @default(PROSPECT)
  onboardingProgress Int                  @default(0)
  waitingOnClient    Boolean              @default(false)
  responses          OnboardingResponse[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([clientId])
}

model OnboardingResponse {
  id           String     @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  stepKey      String
  dataJson     String     @db.Text
  completedAt  DateTime   @default(now())

  @@unique([engagementId, stepKey])
}
